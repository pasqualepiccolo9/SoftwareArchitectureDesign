<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- US16 - Schermata "Coda di riproduzione": header, brano corrente, successivi, stato vuoto. -->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.progetto_sad.controller.QueueController"
      stylesheets="@QueueView.css"
      styleClass="queue-root"
      prefWidth="900" prefHeight="640">

    <!-- ===== HEADER ===== -->
    <HBox styleClass="queue-header" alignment="CENTER_LEFT" spacing="16">
        <padding>
            <Insets top="16" right="24" bottom="16" left="24"/>
        </padding>

        <Button text="← Indietro" styleClass="back-btn" onAction="#handleBack"/>

        <VBox spacing="3" HBox.hgrow="ALWAYS">
            <Label text="Coda di riproduzione" styleClass="queue-main-title"/>
            <Label fx:id="trackCountLabel" text="0 tracce" styleClass="queue-count-label"/>
        </VBox>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="+ Brano" styleClass="queue-action-btn" onAction="#onAddTrack"/>
            <!-- + Playlist: predisposto nel layout, non collegato (US15 fuori scope) -->
            <Button text="+ Playlist" styleClass="queue-action-btn-secondary"/>
        </HBox>
    </HBox>

    <Separator styleClass="divider"/>

    <!-- ===== STATO VUOTO ===== -->
    <VBox fx:id="emptyStateVBox"
          styleClass="empty-state"
          alignment="CENTER"
          VBox.vgrow="ALWAYS"
          visible="false"
          managed="false">
        <Label text="La coda di riproduzione è vuota" styleClass="empty-title"/>
        <Label text="Aggiungi un brano per iniziare"  styleClass="empty-subtitle"/>
    </VBox>

    <!-- ===== CONTENUTO CODA ===== -->
    <ScrollPane fx:id="queueScrollPane"
                styleClass="queue-scroll"
                fitToWidth="true"
                VBox.vgrow="ALWAYS">

        <VBox styleClass="queue-content" spacing="6">
            <padding>
                <Insets top="16" right="24" bottom="24" left="24"/>
            </padding>

            <!-- SEZIONE: IN RIPRODUZIONE -->
            <Label text="In riproduzione" styleClass="section-label"/>

            <HBox fx:id="currentTrackRow"
                  styleClass="current-track-row"
                  alignment="CENTER_LEFT"
                  spacing="12">
                <padding>
                    <Insets top="12" right="16" bottom="12" left="16"/>
                </padding>
                <Label text="▶" styleClass="play-indicator"/>
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="currentTitleLabel"  text="—" styleClass="current-track-title"/>
                    <Label fx:id="currentAuthorLabel" text="—" styleClass="track-meta"/>
                </VBox>
                <Label fx:id="currentDurationLabel" text="—" styleClass="track-duration"/>
            </HBox>

            <!-- SEZIONE: SUCCESSIVI -->
            <Label text="Successivi" styleClass="section-label"/>
            <VBox fx:id="nextTracksVBox" spacing="0"/>

        </VBox>
    </ScrollPane>

</VBox>
