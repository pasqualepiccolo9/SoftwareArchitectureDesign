<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- US3/US4/US9 - Home "Libreria tracce": sidebar playlist + tabella tracce + Player Bar. -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.progetto_sad.controller.LibraryController"
            stylesheets="@LibraryView.css"
            styleClass="home-root"
            prefWidth="1150" prefHeight="760">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="260" spacing="10">
            <padding>
                <Insets top="20" right="14" bottom="16" left="14"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="♫" styleClass="app-logo"/>
                <Label text="Playlist Manager" styleClass="app-title"/>
            </HBox>

            <Label text="Libreria" styleClass="nav-item-selected" maxWidth="Infinity"/>
            <Button text="Coda di riproduzione" styleClass="new-playlist-btn"
                    maxWidth="Infinity" onAction="#openQueue"/>

            <Label text="PLAYLIST" styleClass="section-label"/>

            <ScrollPane styleClass="sidebar-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="playlistListVBox" styleClass="playlist-list" spacing="2"/>
            </ScrollPane>

            <Button text="+ Nuova playlist" styleClass="new-playlist-btn"
                    maxWidth="Infinity" onAction="#onNewPlaylist"/>
        </VBox>
    </left>

    <!-- ===== CENTRO: LIBRERIA TRACCE ===== -->
    <center>
        <VBox styleClass="main-panel" spacing="6">
            <padding>
                <Insets top="20" right="24" bottom="8" left="24"/>
            </padding>

            <!-- header -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label text="Libreria tracce" styleClass="main-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="Cerca..." styleClass="search-field" prefWidth="220"/>
                <!-- US22 - annulla l'ultima operazione (undo); la logica sta nel CommandManager -->
                <Button fx:id="undoBtn" text="↩ Annulla" styleClass="new-playlist-btn" onAction="#onUndo"/>
                <Button text="+ Aggiungi" styleClass="add-btn" onAction="#onAddTrack"/>
            </HBox>

            <!-- intestazione colonne -->
            <HBox styleClass="table-header" alignment="CENTER_LEFT">
                <padding>
                    <Insets top="8" right="16" bottom="6" left="16"/>
                </padding>
                <Label text="Titolo" styleClass="col-header" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <Label text="Autore" styleClass="col-header" minWidth="160" prefWidth="160"/>
                <Label text="Genere" styleClass="col-header" minWidth="120" prefWidth="120"/>
                <Label text="Anno" styleClass="col-header" minWidth="70" prefWidth="70"/>
                <Label text="Durata" styleClass="col-header" minWidth="80" prefWidth="80"/>
                <Region minWidth="100" prefWidth="100"/>
            </HBox>

            <Separator styleClass="divider"/>

            <!-- righe tracce (popolate dal controller) -->
            <ScrollPane styleClass="track-scroll" fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox fx:id="trackListVBox"/>
            </ScrollPane>
        </VBox>
    </center>

    <!-- ===== PLAYER BAR ===== -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="player-bar">
            <padding>
                <Insets top="12" right="24" bottom="12" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12" minWidth="240">
                <Label text="♪" styleClass="player-cover"/>
                <VBox spacing="2">
                    <Label fx:id="playerTitleLabel" text="—" styleClass="player-title"/>
                    <Label fx:id="playerMetaLabel" text="Seleziona una traccia" styleClass="player-meta"/>
                </VBox>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="18">
                <Button fx:id="previousButton" text="⏮" styleClass="player-btn" onAction="#onPreviousTrack"/>
                <Button fx:id="stopButton" text="⏹" styleClass="player-btn" onAction="#onStopPlayer"/>
                <Button fx:id="playButton" text="▶" styleClass="player-btn-main" onAction="#handlePlayPauseAction"/>
                <Button fx:id="nextButton" text="⏭" styleClass="player-btn" onAction="#onNextTrack"/>
                <Button fx:id="skipPlaylistButton" text="⏭ Playlist" styleClass="player-btn" onAction="#onSkipPlaylist"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" spacing="12" minWidth="280">
                <Label fx:id="currentTimeLabel" text="0:00" styleClass="player-meta"/>
                <Slider fx:id="playerProgressSlider" prefWidth="150" mouseTransparent="true" focusTraversable="false"/>
                <Label fx:id="durationLabel" text="0:00" styleClass="player-meta"/>
            </HBox>
        </HBox>
    </bottom>
</BorderPane>
